# =========================
# APP CONFIG
# =========================
ENV=development
DEBUG=True


# =========================
# LLM CONFIG
# =========================
LLM_API_KEY=your_llm_api_key_here

# Optional overrides (defaults exist in code)
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=500
LLM_TIMEOUT=15
LLM_MAX_RETRIES=2


# =========================
# SCRAPER CONFIG
# =========================
SCRAPER_TIMEOUT=10
SCRAPER_RETRIES=2
SCRAPER_CONCURRENCY=5